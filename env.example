const http = require('http');
const { Telegraf, Scenes, session } = require('telegraf');
const config = require('./config');

const startHandler = require('./handlers/start');
const placeCardHandler = require('./handlers/placeCard');
const nearbyHandler = require('./handlers/nearby');
const newPlacesHandler = require('./handlers/newPlaces');
const randomHandler = require('./handlers/random');
const eventsHandler = require('./handlers/events');
const favoritesHandler = require('./handlers/favorites');
const profileHandler = require('./handlers/profile');
const settingsHandler = require('./handlers/settings');
const reviewHandler = require('./handlers/review');
const searchHandler = require('./handlers/search');
const { addPlaceScene, register: registerAddPlace } = require('./handlers/addPlace');
const moderationHandler = require('./admin/moderation');

const bot = new Telegraf(config.botToken);

// --- Session + scenes (in-memory; fine for a single-instance MVP bot) ---
bot.use(session());
const stage = new Scenes.Stage([addPlaceScene]);
bot.use(stage.middleware());

// --- Register feature handlers ---
startHandler.register(bot);
placeCardHandler.register(bot);
nearbyHandler.register(bot);
newPlacesHandler.register(bot);
randomHandler.register(bot);
eventsHandler.register(bot);
favoritesHandler.register(bot);
profileHandler.register(bot);
settingsHandler.register(bot);
reviewHandler.register(bot);
registerAddPlace(bot, stage);
moderationHandler.register(bot);

// View a place by id, e.g. from an inline "Подробнее" button.
bot.action(/^place:view:(\d+)$/, async (ctx) => {
  await ctx.answerCbQuery();
  await placeCardHandler.sendPlaceCard(ctx, Number(ctx.match[1]));
});

// Free-text search must be registered last so scene/menu handlers take priority.
searchHandler.register(bot);

bot.catch((err, ctx) => {
  console.error(`Unhandled error for update ${ctx.update?.update_id}:`, err);
  try {
    ctx.reply('Что-то пошло не так. Попробуй ещё раз.');
  } catch (e) {
    // ignore
  }
});

// --- Minimal health-check HTTP server (Railway can point health checks at it) ---
const server = http.createServer((req, res) => {
  if (req.url === '/health') {
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ status: 'ok', city: config.cityName }));
    return;
  }
  res.writeHead(404);
  res.end();
});
server.listen(config.port, () => console.log(`Health check server listening on port ${config.port}`));

bot.launch().then(() => {
  console.log(`«${config.cityName} Сейчас» bot is running (long polling).`);
});

process.once('SIGINT', () => {
  bot.stop('SIGINT');
  server.close();
});
process.once('SIGTERM', () => {
  bot.stop('SIGTERM');
  server.close();
});
